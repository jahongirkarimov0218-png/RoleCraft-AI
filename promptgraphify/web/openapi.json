            "type": "boolean"
          }
        },
        "required": [
          "files"
        ],
        "title": "AnalyzeRequest",
        "type": "object"
      },
      "AnalyzeResponse": {
        "additionalProperties": false,
        "properties": {
          "graph": {
            "$ref": "#/components/schemas/GraphDocument"
          },
          "graph_id": {
            "title": "Graph Id",
            "type": "string"
          }
        },
        "required": [
          "graph_id",
          "graph"
        ],
        "title": "AnalyzeResponse",
        "type": "object"
      },
      "CycleReport": {
        "additionalProperties": false,
