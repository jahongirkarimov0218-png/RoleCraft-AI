{
  "components": {
    "schemas": {
      "AnalysisConfig": {
        "additionalProperties": false,
        "properties": {
          "layer_b": {
            "title": "Layer B",
            "type": "boolean"
          }
        },
        "required": [
          "layer_b"
        ],
        "title": "AnalysisConfig",
        "type": "object"
      },
      "AnalyzeRequest": {
        "additionalProperties": false,
        "properties": {
          "files": {
            "items": {
              "$ref": "#/components/schemas/FileInput"
            },
            "maxItems": 200,
            "minItems": 1,
            "title": "Files",
            "type": "array"
          },
          "layer_b": {
            "default": false,
            "description": "Enable the optional LLM layer. Off by default; when on, the prompt text is sent to the configured provider (see /api/health).",
