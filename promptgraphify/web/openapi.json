          },
          "nodes": {
            "items": {
              "type": "string"
            },
            "title": "Nodes",
            "type": "array"
          }
        },
        "required": [
          "nodes",
          "edges",
          "evidence",
          "certainty"
        ],
        "title": "CycleReport",
        "type": "object"
      },
      "DagEdge": {
