# PromptGraphify configuration. Nothing here is required: the analysis, the API, the CLI and the UI work without any
# of it and without any key. Nothing reads a ".env" file by itself; load it into the environment of the process, e.g.
#   set -a; . ./.env; set +a; uv run promptgraphify serve        (or: docker compose --env-file .env up)
# Never commit a file that contains a real key (.env is git-ignored).

# --- HTTP API --------------------------------------------------------------------------------------------------
# SQLite file that stores analysed graphs (default: ./promptgraphify-out/graphs.sqlite3)
#PROMPTGRAPHIFY_DB=
# Largest request body in bytes (default 4000000), most characters over all files of one analysis (default 500000),
# and seconds before an analysis is answered with 504 (default 30)
#PROMPTGRAPHIFY_MAX_REQUEST_BYTES=4000000
#PROMPTGRAPHIFY_MAX_INPUT_CHARS=500000
#PROMPTGRAPHIFY_ANALYZE_TIMEOUT_S=30

# --- Web UI (read when `npm run build` runs, because Next bakes the proxy rule into the build) ------------------------
#PROMPTGRAPHIFY_API_URL=http://127.0.0.1:8000

# --- Optional LLM layer (Layer B). OFF unless PROVIDER and MODEL are both set. ------------------------------------------
# When it is on and a request asks for it ("Use LLM layer" in the UI, `analyze --llm` in the CLI), the PROMPT TEXT IS
# SENT to the endpoint below. Proposals are verified against your text; anything unprovable is dropped and logged.
# The key is read from the environment only, is never logged, and is never written to graph.json.
#PROMPTGRAPHIFY_LLM_PROVIDER=openai-compatible
#PROMPTGRAPHIFY_LLM_MODEL=
# Any OpenAI-compatible /chat/completions endpoint. https is required unless the host is this machine (a local server such
# as Ollama or LM Studio may use http://localhost:...). Credentials in the URL are rejected: use the key variable.
#PROMPTGRAPHIFY_LLM_BASE_URL=https://api.openai.com/v1
#PROMPTGRAPHIFY_LLM_API_KEY=
#PROMPTGRAPHIFY_LLM_TIMEOUT_S=30
